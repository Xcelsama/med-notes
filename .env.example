# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# (For local testing you can also copy this file to ".env" and fill it in. Never commit .env.)

# Your Cloudflare account ID (R2 overview page, right side) - OR set R2_ENDPOINT instead
R2_ACCOUNT_ID=
# R2 -> Manage API tokens -> Create API token (Object Read & Write, limited to your bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The exact name of your bucket
R2_BUCKET=

# The password you will type to open your notebook. Pick a long one.
NOTEBOOK_PASSWORD=

# Optional: a long random string used to sign login cookies
# SESSION_SECRET=
